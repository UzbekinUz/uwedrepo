{"title": "Aniqmas integral: 30 savol (jadval integrallari)", "description": "Asosiy formulalar, chiziqli argument (kx + b), trigonometrik, kasr va teskari trigonometrik funksiyalarning integrallari. Har savolda 4 variant va izoh.", "questions": [{"text": "∫ 5 dx = ?", "options": ["5x + C", "5 + C", "5x²/2 + C", "x/5 + C"], "correct": 0, "explanation": "O'zgarmasning integrali: ∫ a dx = ax + C."}, {"text": "∫ x⁷ dx = ?", "options": ["7x⁶ + C", "x⁸/8 + C", "x⁸ + C", "x⁷/7 + C"], "correct": 1, "explanation": "Daraja formulasi: ∫ xⁿ dx = xⁿ⁺¹/(n + 1) + C, n = 7."}, {"text": "∫ x⁻³ dx = ?", "options": ["1/(2x²) + C", "−3x⁻⁴ + C", "−1/(4x⁴) + C", "−1/(2x²) + C"], "correct": 3, "explanation": "n = −3: x⁻²/(−2) = −1/(2x²)."}, {"text": "∫ (3x + 1)⁴ dx = ?", "options": ["(3x + 1)⁵/5 + C", "3(3x + 1)⁵/5 + C", "(3x + 1)⁵/15 + C", "12(3x + 1)³ + C"], "correct": 2, "explanation": "∫ f(kx + b) dx = F(kx + b)/k + C: (3x + 1)⁵/5 ni k = 3 ga bo'lamiz."}, {"text": "∫ (5 − 2x)³ dx = ?", "options": ["(5 − 2x)⁴/8 + C", "−(5 − 2x)⁴/8 + C", "(5 − 2x)⁴/4 + C", "−(5 − 2x)⁴/2 + C"], "correct": 1, "explanation": "(5 − 2x)⁴/4 ni k = −2 ga bo'lamiz: −(5 − 2x)⁴/8."}, {"text": "∫ dx/x = ?", "options": ["−1/x² + C", "ln|x| + C", "x⁰/0 + C", "ln x² + C"], "correct": 1, "explanation": "∫ dx/x = ln|x| + C (n = −1 uchun daraja formulasi ishlamaydi)."}, {"text": "∫ dx/(4x + 3) = ?", "options": ["4·ln|4x + 3| + C", "ln|4x + 3| + C", "−4/(4x + 3)² + C", "(1/4)·ln|4x + 3| + C"], "correct": 3, "explanation": "Chiziqli argument: ln|4x + 3| ni k = 4 ga bo'lamiz."}, {"text": "∫ dx/(7 − 2x) = ?", "options": ["(1/2)·ln|7 − 2x| + C", "−2·ln|7 − 2x| + C", "−(1/2)·ln|7 − 2x| + C", "ln|7 − 2x| + C"], "correct": 2, "explanation": "k = −2: ln|7 − 2x|/(−2)."}, {"text": "∫ 3ˣ dx = ?", "options": ["3ˣ/ln 3 + C", "3ˣ·ln 3 + C", "3ˣ⁺¹/(x + 1) + C", "x·3ˣ⁻¹ + C"], "correct": 0, "explanation": "∫ aˣ dx = aˣ/ln a + C."}, {"text": "∫ e²ˣ⁺¹ dx = ?", "options": ["2·e²ˣ⁺¹ + C", "e²ˣ⁺¹ + C", "(1/2)·e²ˣ⁺¹ + C", "e²ˣ⁺²/(2x + 2) + C"], "correct": 2, "explanation": "∫ eᵏˣ⁺ᵇ dx = eᵏˣ⁺ᵇ/k + C, k = 2."}, {"text": "∫ sin x dx = ?", "options": ["−cos x + C", "cos x + C", "−sin x + C", "sin²x/2 + C"], "correct": 0, "explanation": "(−cos x)′ = sin x."}, {"text": "∫ sin(2x + 1) dx = ?", "options": ["(1/2)·cos(2x + 1) + C", "−2·cos(2x + 1) + C", "2·cos(2x + 1) + C", "−(1/2)·cos(2x + 1) + C"], "correct": 3, "explanation": "−cos(2x + 1) ni k = 2 ga bo'lamiz."}, {"text": "∫ sin(5 − 3x) dx = ?", "options": ["−(1/3)·cos(5 − 3x) + C", "3·cos(5 − 3x) + C", "−3·cos(5 − 3x) + C", "(1/3)·cos(5 − 3x) + C"], "correct": 3, "explanation": "−cos(5 − 3x)/(−3) = (1/3)·cos(5 − 3x): ikki minus plus beradi."}, {"text": "∫ cos x dx = ?", "options": ["sin x + C", "−sin x + C", "cos²x/2 + C", "−cos x + C"], "correct": 0, "explanation": "(sin x)′ = cos x."}, {"text": "∫ cos(4x − 1) dx = ?", "options": ["4·sin(4x − 1) + C", "(1/4)·sin(4x − 1) + C", "−(1/4)·sin(4x − 1) + C", "sin(4x − 1) + C"], "correct": 1, "explanation": "sin(4x − 1) ni k = 4 ga bo'lamiz."}, {"text": "∫ cos(2 − 5x) dx = ?", "options": ["(1/5)·sin(2 − 5x) + C", "−(1/5)·sin(2 − 5x) + C", "−5·sin(2 − 5x) + C", "5·sin(2 − 5x) + C"], "correct": 1, "explanation": "sin(2 − 5x)/(−5)."}, {"text": "∫ tg x dx = ?", "options": ["ln|cos x| + C", "−ln|cos x| + C", "1/cos²x + C", "ln|sin x| + C"], "correct": 1, "explanation": "tg x = sin x/cos x; t = cos x, dt = −sin x dx ⇒ −ln|cos x|."}, {"text": "∫ ctg 3x dx = ?", "options": ["3·ln|sin 3x| + C", "−(1/3)·ln|sin 3x| + C", "(1/3)·ln|cos 3x| + C", "(1/3)·ln|sin 3x| + C"], "correct": 3, "explanation": "∫ ctg x dx = ln|sin x| + C; k = 3 ga bo'lamiz."}, {"text": "∫ sin²x dx = ?", "options": ["x/2 + (1/4)·sin 2x + C", "sin³x/3 + C", "x/2 − (1/4)·sin 2x + C", "−cos²x + C"], "correct": 2, "explanation": "sin²x = (1 − cos 2x)/2 ⇒ x/2 − sin 2x/4."}, {"text": "∫ cos²x dx = ?", "options": ["x/2 + (1/4)·sin 2x + C", "x/2 − (1/4)·sin 2x + C", "cos³x/3 + C", "sin²x + C"], "correct": 0, "explanation": "cos²x = (1 + cos 2x)/2 ⇒ x/2 + sin 2x/4."}, {"text": "∫ dx/sin²x = ?", "options": ["ctg x + C", "tg x + C", "−ctg x + C", "−1/sin x + C"], "correct": 2, "explanation": "(ctg x)′ = −1/sin²x, demak ∫ dx/sin²x = −ctg x + C."}, {"text": "∫ dx/cos²x = ?", "options": ["−tg x + C", "ctg x + C", "tg x + C", "1/cos x + C"], "correct": 2, "explanation": "(tg x)′ = 1/cos²x."}, {"text": "∫ dx/cos²(2x + 1) = ?", "options": ["2·tg(2x + 1) + C", "tg(2x + 1) + C", "−(1/2)·ctg(2x + 1) + C", "(1/2)·tg(2x + 1) + C"], "correct": 3, "explanation": "tg(2x + 1) ni k = 2 ga bo'lamiz."}, {"text": "∫ dx/sin²(3x − 2) = ?", "options": ["(1/3)·ctg(3x − 2) + C", "−3·ctg(3x − 2) + C", "(1/3)·tg(3x − 2) + C", "−(1/3)·ctg(3x − 2) + C"], "correct": 3, "explanation": "−ctg(3x − 2) ni k = 3 ga bo'lamiz."}, {"text": "∫ dx/√(1 − x²) = ?", "options": ["arccos x + C", "arcsin x + C", "arctg x + C", "√(1 − x²) + C"], "correct": 1, "explanation": "(arcsin x)′ = 1/√(1 − x²)."}, {"text": "∫ dx/(1 + x²) = ?", "options": ["arcsin x + C", "ln(1 + x²) + C", "arctg x + C", "ln|1 + x| + C"], "correct": 2, "explanation": "(arctg x)′ = 1/(1 + x²)."}, {"text": "∫ dx/(x² + 9) = ?", "options": ["arctg(x/3) + C", "(1/3)·arctg(x/3) + C", "(1/9)·arctg(x/9) + C", "3·arctg(3x) + C"], "correct": 1, "explanation": "∫ dx/(x² + a²) = (1/a)·arctg(x/a) + C, a = 3."}, {"text": "∫ dx/√(4 − x²) = ?", "options": ["(1/2)·arcsin(x/2) + C", "arcsin(x/4) + C", "2·arcsin(2x) + C", "arcsin(x/2) + C"], "correct": 3, "explanation": "∫ dx/√(a² − x²) = arcsin(x/a) + C, a = 2 (oldida koeffitsiyent yo'q)."}, {"text": "∫ dx/(x² − 16) = ?", "options": ["(1/8)·ln|(x − 4)/(x + 4)| + C", "(1/4)·ln|(x − 4)/(x + 4)| + C", "(1/8)·ln|(x + 4)/(x − 4)| + C", "(1/4)·arctg(x/4) + C"], "correct": 0, "explanation": "∫ dx/(x² − a²) = (1/(2a))·ln|(x − a)/(x + a)| + C, a = 4 ⇒ 1/8."}, {"text": "∫ dx/(x² − 1) = ?", "options": ["(1/2)·ln|(x − 1)/(x + 1)| + C", "ln|(x − 1)/(x + 1)| + C", "(1/2)·ln|(x + 1)/(x − 1)| + C", "arctg x + C"], "correct": 0, "explanation": "a = 1: 1/(2a) = 1/2."}]}