PORT=5000
# Bo'sh qoldirilsa, lokal fayl-asosli MongoDB (mongodb-memory-server) ishga tushadi.
# Production uchun: mongodb+srv://USER:PASS@cluster/uwedrepo
MONGODB_URI=
JWT_SECRET=ozgartiring-uzun-tasodifiy-satr
CLIENT_ORIGIN=http://localhost:5173
# Platforma komissiyasi (%) va birinchi dars chegirmasi (%)
COMMISSION_PERCENT=10
FIRST_LESSON_DISCOUNT=20
# Birinchi admin (seed vaqtida yaratiladi)
ADMIN_EMAIL=admin@uwedrepo.uz
ADMIN_PASSWORD=Admin12345

# Telegram orqali kirish: @BotFather da /newbot orqali bot yarating va tokenni shu yerga qo'ying.
# Bo'sh bo'lsa, saytda email orqali ro'yxatdan o'tish ishlaydi.
TELEGRAM_BOT_TOKEN=

# Production: sayt manzili (Render o'zi RENDER_EXTERNAL_URL beradi). Telegram havolalari va webhook shundan olinadi.
# PUBLIC_URL=https://uwedrepo.onrender.com
