PORT=5000
# Bo'sh qoldirilsa, lokal fayl-asosli MongoDB (mongodb-memory-server) ishga tushadi.
# Production uchun: mongodb+srv://USER:PASS@cluster/uwedrepo
MONGODB_URI=
JWT_SECRET=ozgartiring-uzun-tasodifiy-satr
CLIENT_ORIGIN=http://localhost:5173
# Platforma komissiyasi (%) va birinchi dars chegirmasi (%)
COMMISSION_PERCENT=10
FIRST_LESSON_DISCOUNT=20
# Birinchi admin (seed vaqtida yaratiladi)
ADMIN_EMAIL=admin@uwedrepo.uz
ADMIN_PASSWORD=Admin12345

# Telegram orqali kirish: @BotFather da /newbot orqali bot yarating va tokenni shu yerga qo'ying.
# Bo'sh bo'lsa, saytda email orqali ro'yxatdan o'tish ishlaydi.
TELEGRAM_BOT_TOKEN=

# Mashq testlaridagi "Nega noto'g'ri?" AI izohi: console.anthropic.com dan olingan kalit.
# Bo'sh bo'lsa testlar ishlayveradi, faqat AI tugmasi ko'rinmaydi. Kalitni hech qachon repozitoriyga yozmang.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Production: sayt manzili (Render o'zi RENDER_EXTERNAL_URL beradi). Telegram havolalari va webhook shundan olinadi.
# PUBLIC_URL=https://uwedrepo.onrender.com

# To'lov. demo (standart) — sinov rejimi: talaba saytning o'z to'lov sahifasidan o'tadi, pul yechilmaydi.
# live — Payme/Click sahifasiga yo'naltiriladi (faqat kaliti kiritilgan provayderlar ko'rinadi). Kalitlarni repozitoriyga yozmang.
PAYMENT_MODE=demo
PAYME_MERCHANT_ID=
PAYME_KEY=
# PAYME_TEST=1
# PAYME_TEST_KEY=
# Fiskal chek: MXIK (IKPU) kodi, o'lchov birligi (package) kodi va QQS foizi
# PAYME_MXIK=
# PAYME_PACKAGE_CODE=
# PAYME_VAT_PERCENT=0
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
